# Managed by bu_rcs.coldfront -- do not edit. Fragment 20-auth.
# Plugin enablement flags must live here: they are read while INSTALLED_APPS is
# assembled, before local_settings.py loads. Secrets are never set here.
{% if cf_auth_method == 'oidc' %}
PLUGIN_AUTH_OIDC=True
OIDC_RP_CLIENT_ID={{ cf_oidc_client_id }}
OIDC_OP_AUTHORIZATION_ENDPOINT={{ cf_oidc_base }}/auth
OIDC_OP_TOKEN_ENDPOINT={{ cf_oidc_base }}/token
OIDC_OP_USER_ENDPOINT={{ cf_oidc_base }}/userinfo
OIDC_OP_JWKS_ENDPOINT={{ cf_oidc_base }}/certs
{% elif cf_auth_method == 'ldap' %}
PLUGIN_AUTH_LDAP=True
AUTH_LDAP_SERVER_URI={{ cf_ldap_uri }}
AUTH_LDAP_USER_SEARCH_BASE={{ cf_ldap_user_base }}
AUTH_LDAP_BIND_DN={{ cf_ldap_bind_dn }}
{% else %}
# {{ cf_auth_method }}: no plugin flags needed. For remote_user the middleware
# and backend are wired in local_settings.d, since there is no env switch.
{% endif %}
{% if cf_user_search == 'ldap' %}

PLUGIN_LDAP_USER_SEARCH=True
LDAP_USER_SEARCH_SERVER_URI={{ cf_ldap_uri }}
LDAP_USER_SEARCH_BASE={{ cf_ldap_user_base }}
{% endif %}
