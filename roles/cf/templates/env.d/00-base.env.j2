# Managed by bu_rcs.coldfront -- do not edit. Fragment 00-base.
# Non-secret settings only. Secrets are podman secrets; the database
# connection is assembled in local_settings.py from the mounted secret.
# Unquoted values: this file is read as an env file, quotes are not stripped.
{% if cf_pointer_delivery == 'env_file' %}
# Config pointers. COLDFRONT_ENV is a real container env var (it is how this
# file is found); these two are resolved from here.
COLDFRONT_CONFIG={{ _cf_ct_config }}
{% if _cf_local_urls_enabled | bool %}
COLDFRONT_URLS={{ _cf_ct_urls }}
{% endif %}

{% endif %}
ALLOWED_HOSTS=*
DEBUG={{ 'True' if cf_nonprod | bool else 'False' }}
TIME_ZONE={{ cf_timezone }}
CENTER_NAME={{ cf_center_name }}
{% if cf_base_path %}
BASE_PATH={{ cf_base_path }}
{% endif %}

REDIS_HOST={{ _cf_redis_host_effective }}
# REDIS_PORT is not in the documented settings table; harmless if ignored.
REDIS_PORT={{ cf_redis_port }}

STATIC_ROOT=/srv/coldfront/static
SITE_TEMPLATES=/usr/share/coldfront/site/templates
SITE_STATIC=/usr/share/coldfront/site/static

Q_CLUSTER_RETRY={{ cf_q_cluster_retry }}
Q_CLUSTER_TIMEOUT={{ cf_q_cluster_timeout }}
{% if cf_nonprod | bool %}

# Non-prod rails: keep a cloned production database from mailing real PIs
# or writing to real scheduler/identity backends.
EMAIL_DEVELOPMENT_EMAIL_LIST={{ cf_dev_email_list }}
SLURM_NOOP=True
FREEIPA_NOOP=True
{% endif %}
